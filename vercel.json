{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "html/**/*.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/html/(.*)", "destination": "/html/$1" },
    { "source": "/(.*)", "destination": "/html/$1" }
  ]
}
