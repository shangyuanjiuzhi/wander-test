{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "html/**/*.html",
      "use": "static"
    },
    {
      "src": "css/**/*.css",
      "use": "static"
    },
    {
      "src": "iconfont/**/*",
      "use": "static"
    },
    {
      "src": "img/**/*",
      "use": "static"
    }
  ],
  "routes": [
    {
      "src": "/api/packing-suggestions",
      "dest": "/api/packing-suggestions.js"
    },
    {
      "src": "/html/(.*)",
      "dest": "/html/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/iconfont/(.*)",
      "dest": "/iconfont/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "/img/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/html/$1"
    }
  ]
}
